# # LLM configuration
# # Local default:
# ANCHOR_LLM=ollama:granite3.3:8b

# Hugging Face Inference Providers expose an OpenAI-compatible router.
# To use it, set OPENAI_API_KEY to your Hugging Face token and uncomment:
# OPENAI_API_KEY=hf_your_token_here
# OPENAI_API_BASE=https://router.huggingface.co/v1
# ANCHOR_LLM=openai:openai/gpt-oss-20b
# ANCHOR_SAILOR_LLM=openai:openai/gpt-oss-20b
# Some providers support tool calls but do not support forced tool_choice modes such as "required" or "single".
# For those providers, use:
# ANCHOR_LLM_TOOL_CHOICE_SUPPORT=none,auto
